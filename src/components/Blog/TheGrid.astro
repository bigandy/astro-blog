---
interface Props {
    columns?: number;
    style?: string;
}

const { columns = 2, style } = Astro.props;
---

<container>
    <the-grid class="the-grid" style={style}>
        <slot />
    </the-grid>
</container>

<style define:vars={{ columns }}>
    @scope (container) {
        the-grid {
            /* --_columns: 1; */

            display: grid;
            gap: --fb-spacing(2);
            gap: --spacing(2);
            margin-block: --fb-spacing(2);
            margin-block: --spacing(2);
            rule: 1px solid;
            rule-break: intersection;
            column-rule-visibility-items: between;
        }
    }
</style>
