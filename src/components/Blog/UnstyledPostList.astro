---
import BlogPostPreview from "@components/Blog/BlogPostPreview.astro";
import { type Collection } from "@components/Blog/utils/getAllPosts";
interface Props {
    posts: Array<any>; // AHTODO: get this sorted
    collection?: Collection;
}
const { posts, collection } = Astro.props;
---

<div class="blog-post-list">
    {
        posts.map((post) => (
            <BlogPostPreview
                post={post}
                postIndex={post.postIndex}
                collection={collection}
            />
        ))
    }
</div>
<style>
    .blog-post-list {
        display: grid;
        gap: --fb-spacing(2);
        gap: --spacing(2);
        rule: 1px dashed var(--theme-accent);

        @supports not (rule: 1px solid) {
            gap: --fb-spacing(1);
            gap: --spacing(1);

            > :global(*):not(:last-of-type) {
                padding-block-end: --fb-spacing(1);
                padding-block-end: --spacing(1);
                border-block-end: 1px solid;
            }
        }
    }
</style>
