---
import Comments from "@kckempf/astro-standard-site/components/Comments.astro";

import { ATPROTO_DID } from "astro:env/server";

const { bskyPostId } = Astro.props.frontmatter;

const bskyPostUri = bskyPostId
    ? `at://${ATPROTO_DID}/app.bsky.feed.post/${bskyPostId}`
    : "";
---

<div>
    <slot />
</div>

{
    bskyPostUri && (
        <Comments
            bskyPostUri={bskyPostUri}
            canonicalUrl={Astro.url.href}
            showReplyLink={true}
            class="comments"
        />
    )
}

<style>
    .comments {
        /* --color-border-soft: transparent; */
        --color-text-primary: var(--theme-accent);
        --color-text-secondary: black;
        --color-text-muted: gray;
        --color-text-link: var(--theme-accent);
        /* --color-bg-elevated: pink; */
    }

    div :global(h2) {
        font-size: var(--font-size-2);
    }

    div :global(h3) {
        font-size: var(--font-size-1);
    }

    div :global(ul) {
        padding-inline-start: 1rem;
    }

    div :global(li),
    div :global(p) {
        margin-block-end: 0.5rem;
    }

    div :global(table) {
        inline-size: 100%;
        max-inline-size: 600px;
        margin-block: 2rem;
        table-layout: fixed;
        border-collapse: collapse;

        td,
        th {
            border: 1px solid var(--theme-accent);
            padding: 0.25rem 0.5rem;
        }
    }
</style>
