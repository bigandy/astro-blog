---
import { footerPages } from "./pages";
import { socialLinks } from "./social-links";
import { getNavClassName } from "./utils";

const requestPathname = Astro.url.pathname;

const prefix = Astro.currentLocale !== "en" ? `/${Astro.currentLocale}` : "";
const locale = Astro.currentLocale ?? "en";
---

<nav class="layout footer-nav">
    <ul class="layout-inner nav">
        {
            footerPages.map((entry) => {
                const className = getNavClassName(entry.url, requestPathname);
                const href = prefix + entry.url;

                return (
                    <li>
                        <a class={className} href={href}>
                            {(locale === "fr" && entry.title["fr"]) ||
                                entry.title.default}
                        </a>
                    </li>
                );
            })
        }
    </ul>

    {
        socialLinks.length > 0 && (
            <ul class="layout-inner nav nav-social">
                {socialLinks.map(({ url, icon, title }) => {
                    const className = getNavClassName(url, requestPathname);

                    return (
                        <li>
                            <a
                                class={className}
                                rel="me"
                                href={url}
                                target="_blank"
                                style={`color: ${icon.color}`}
                            >
                                <svg height="1em" width="1em">
                                    <use
                                        href={`/images/sprite.svg#${icon.name}`}
                                    />
                                </svg>
                                {title}
                            </a>
                        </li>
                    );
                })}
            </ul>
        )
    }
</nav>

<style>
    nav {
        gap: 1rem;
        display: inline-flex;
    }
    ul {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 1em;
        list-style: "";
        padding: 0;
    }

    .nav-social {
        gap: 0.75rem;
    }

    a {
        border-block-end: 2px solid transparent;
    }

    svg {
        margin-inline-end: 0.25rem;
        vertical-align: -0.2rem;
    }

    a:hover,
    .active {
        border-block-end-color: var(--theme-accent);
    }

    .social-link {
        color: attr(data-attr-color type(<color>));
    }

    .social-icon {
        vertical-align: -0.25em;
    }
</style>
