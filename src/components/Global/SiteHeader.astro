---
import HeaderNav from "@components/Nav/HeaderNav.astro";

const { hidePhoto = false } = Astro.props;

const homeUrl = Astro.currentLocale === "fr" ? `/${Astro.currentLocale}` : "/";
---

<header>
    <div class="layout-inner">
        <HeaderNav hidePhoto={hidePhoto} />
        <h1>
            <a href={homeUrl}> Andrew JD Hudson </a>
        </h1>
    </div>
</header>

<style>
    header {
        display: grid;
        grid-template-columns: subgrid;
        grid-column: page;
        padding-block-start: --fb-spacing(3);
        padding-block-start: --spacing(3);
        margin-block-end: --fb-spacing(3);
        margin-block-end: --spacing(3);
        background: black;

        h1 {
            view-transition-name: main-title;

            a:focus,
            a:hover {
                text-decoration: none;
                outline: none;
            }
        }
    }

    .layout-inner {
        padding-block-start: --fb-spacing(3);
        padding-block-start: --spacing(3);
        grid-template-columns: subgrid;
        grid-column: bleed;
        grid-row: 1;
        display: grid;
    }

    h1 {
        --stroke-width: 5px;
        min-font-size: 3.5rem;
        text-box: trim-both cap alphabetic;
        margin-block: 0;
        translate: 0 -10px;
        paint-order: stroke fill;
        -webkit-text-stroke: var(--stroke-width) var(--theme-accent);

        @supports (text-fit: grow consistent) {
            max-inline-size: 2000px;
            text-fit: grow consistent;
            grid-column-start: 2;
            grid-column-end: -2;
        }

        @supports not (text-fit: grow consistent) {
            font-size: calc(var(--progress) * 120px + 28px);
            --stroke-width: 10px;
            --progress: calc(progress(100vi, 400px, 2000px));
            grid-column-start: 2;
            grid-column-end: -1;
        }

        a {
            color: var(--darker-theme-accent);
            font-weight: bold;

            &:hover {
                -webkit-text-stroke-color: var(--darker-theme-accent);
                color: revert-layer;
                text-decoration: none;
            }
        }
    }
</style>
