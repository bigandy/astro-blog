---
import DefaultLayout from "@layouts/DefaultLayout.astro";
import { getFeedFromBsky } from "@utils/getFeedFromBsky";

const feed = await getFeedFromBsky();

const { title } = Astro.props;
---

<DefaultLayout title={title} accent="oklch(0.52 0.12 189.58)">
    <slot />
    <ul>
        {
            feed && feed?.length > 0 ? (
                feed.map((item) => {
                    console.log("HUZZAH ITEM:", item);
                    return (
                        <li class="item">
                            <a
                                class="item-author"
                                href={`https://bsky.app/profile/${item.post.author.did}`}
                                target="_blank"
                            >
                                <img
                                    src={item.post.author.avatar}
                                    alt=""
                                    height="30"
                                    width="30"
                                />
                                <p>{item.post.author.handle}</p>
                            </a>
                            {/* <div>
                                <pre>{JSON.stringify(item, null, 2)}</pre>
                            </div> */}
                            <div class="text">{item.text}</div>

                            <div class="posted-at">
                                posted at {item.createdAt}
                            </div>
                            <a target="_blank" href={item.url}>
                                see original post on bsky.app
                            </a>
                        </li>
                    );
                })
            ) : (
                <div>No feed</div>
            )
        }
    </ul>
</DefaultLayout>

<style>
    :root {
        --theme-accent: ;
    }

    ul {
        display: grid;
        gap: 2rem;
        list-style: "";
        padding: 0;
        rule: 1px solid var(--color-gray-300);
    }

    .text {
        margin-block-end: 0.25rem;
    }

    a {
        margin-inline-start: 1rem;

        &:hover,
        &:focus {
            text-decoration: underline;
        }
    }

    a,
    .posted-at {
        display: inline-block;
        font-size: 80%;
        color: var(--color-gray-500);
    }

    .item-author {
        margin-block-end: 0.5rem;
        margin-inline-start: 0;

        &:hover,
        &:focus {
            p {
                text-decoration: underline;
            }
        }

        img {
            border-radius: calc(Infinity * 1px);
            margin-inline-end: 0.5rem;
            vertical-align: -0.6rem;
        }

        p,
        img {
            display: inline-block;
        }
    }
</style>
