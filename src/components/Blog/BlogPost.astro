---

import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

import BlogContent from "@components/Blog/BlogContent.astro";
import BlogPostHeader from "@components/Blog/BlogPostHeader.astro";
import BackArrow from "@components/Global/BackArrow.astro";
import EditPostOnGithub from "@components/Global/EditPostOnGithub.astro";
import { isProduction } from "@utils/isProduction";

const isFrench = Astro.currentLocale === "fr";

interface Props {
	post: CollectionEntry<"blog" | "weeknotes" | "blog-fr" | "weeknotes-fr">;
	showBackLink?: boolean;
	showDate?: boolean;
	collection: "blog" | "weeknotes" | "blog-fr" | "weeknotes-fr";
	postIndex?: number;
	hasTranslation?: boolean;
}

const {
	post,
	showBackLink = true,
	showDate = true,
	collection = "blog",
	postIndex,
	// hasTranslation,
} = Astro.props;

const { Content } = await render(post);

const hasCodeSnippet = post.body?.includes('```') || post.body?.includes('<pre><code');

console.log({hasCodeSnippet})

const prefix = Astro.currentLocale === 'fr' ? `/fr` : "";

const backLinkText = isFrench
	? `retour à tous les articles du ${collection}`
	: `Back to all ${collection} posts`;

const noTranslationText =
	Astro.currentLocale === "fr"
		? "Pas de traduction disponible."
		: "No translation available";

// const showTranslationText = collection !== "weeknotes" && !hasTranslation;
const showTranslationText = false;

const isYoutube = post.data.tags?.includes('youtube');
// const available_themes = ["cobalt2","dracula","flexoki","github","gruvbox","index","min","monokai","night-owl","solarized-light","tokyo-night","vesper","vscode-plus"]
const theme = "flexoki";
---
<article class="content post inner" data-syntax-theme={theme}>
    {
        showTranslationText && (
            <p class="no-translation">{noTranslationText}</p>
        )
    }
    <BlogPostHeader
        date={showDate ? post.data.date : undefined}
        title={post.data.title}
        isPreview={false}
        slug={post.id}
        viewTransitionName={post.id}
        postIndex={postIndex}
    />

    <BlogContent frontmatter={post.data}>
        {post.data.description && (
            <p>{post.data.description}</p>
        )}

        <Content />
    </BlogContent>


    {
        showBackLink && (
            <BackArrow url={`${prefix}/${collection}/`} title={backLinkText} />
        )
    }
    {isProduction && (
        <EditPostOnGithub slug={post.id} collection={collection} />
    )}
</article>


<style>
    .no-translation {
        inline-size: 100%;
        padding: 1rem;
        border: 0.25rem dotted red;
        max-inline-size: unset;
        text-align: center;
    }
</style>


{isYoutube && (
    <script type="module" src="/js/lite-yt-embed.js"></script>
    <link rel="stylesheet" href="/css/lite-yt-embed.css" />
)}
{hasCodeSnippet && (
    <link
        rel="stylesheet"
        href={`https://cdn.jsdelivr.net/npm/microlighter@2/dist/themes/${theme}.css`}
    />
    <script
        type="module"
        src="https://cdn.jsdelivr.net/npm/microlighter@2/dist/microlighter.min.js"
    ></script>
    )
}