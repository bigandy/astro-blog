{
	"name": "andrewhudson-dev-astro",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "SKIP_OG=true astro build",
		"build:noskipog": "astro build ",
		"build:check": "npm run build && npm run check",
		"preview": "astro preview",
		"update": "npx @astrojs/upgrade && npx npm-check-updates -u && npm i",
		"update:beta": "npx @astrojs/upgrade beta && npx npm-check-updates -u && npm i",
		"lint-format": "biome check --write",
		"lint:css": "stylelint \"**/*.{css, astro}\"",
		"lint:css:fix": "stylelint \"**/*.{css, astro}\" --fix",
		"create-post": "node ./script.mjs",
		"check": "astro check --noSync",
		"test": "vitest",
		"sequoia:dryrun": "sequoia publish -n -v",
		"sequoia:publish": "sequoia publish"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "0.4.0",
		"@astrojs/mdx": "8.0.0",
		"@astrojs/react": "6.0.5",
		"@astrojs/rss": "4.0.19",
		"@astrojs/svelte": "9.0.1",
		"@awesome.me/astro-lit": "5.0.4",
		"@expressive-code/plugin-collapsible-sections": "0.44.2",
		"@kckempf/astro-standard-site": "1.1.5",
		"@lit-labs/preact-signals": "1.0.3",
		"astro": "7.3.1",
		"astro-expressive-code": "0.44.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"satori": "0.33.4",
		"sharp": "0.35.4",
		"svelte": "5.57.0",
		"typescript": "6.0.3"
	},
	"devDependencies": {
		"@11ty/eleventy-fetch": "5.1.3",
		"@astrojs/check": "0.9.10",
		"@biomejs/biome": "2.5.12",
		"@clack/prompts": "1.7.0",
		"@expressive-code/plugin-line-numbers": "0.44.2",
		"@notionhq/client": "5.26.0",
		"@types/markdown-it": "14.2.0",
		"@types/node": "26.4.1",
		"@types/sanitize-html": "2.16.1",
		"execa": "10.0.1",
		"gray-matter": "4.0.3",
		"linkedom": "0.18.13",
		"markdown-it": "15.0.1",
		"postcss-custom-media": "12.0.1",
		"postcss-html": "2.0.0",
		"postcss-import": "17.0.0",
		"postcss-values-parser": "8.0.0",
		"sanitize-html": "2.17.7",
		"stylelint": "17.15.0",
		"stylelint-config-html": "2.0.0",
		"stylelint-plugin-logical-css": "2.1.0",
		"temporal-polyfill-lite": "0.4.3",
		"vitest": "5.0.0"
	}
}
